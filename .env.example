# ---------------------------------------------------------------------------
# Tele2Rubika - environment variables
# Copy to .env for LOCAL development. On GitHub put these in
# Settings -> Secrets and variables -> Actions  (repo VARIABLES for non-secret
# values, repo SECRETS for anything sensitive).
# ---------------------------------------------------------------------------

# === Telegram (Telethon user client) ========================================
# Get api_id / api_hash from https://my.telegram.org
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Session string. Generate it ONCE locally with:
#     python scripts/auth_telegram.py
# then paste the printed value here. On GitHub this must be a SECRET.
# If left empty the bot will still run (Rubika side only) and will log a
# warning that Telegram monitoring is disabled.
TELEGRAM_SESSION_STRING=

# Comma separated list of Telegram channels to monitor.
# Usernames (@foo), invite links or numeric ids all work.
TELEGRAM_CHANNELS=@vpn_channel_one,@vpn_channel_two

# How many recent messages to scan per channel on startup (catch-up window).
TELEGRAM_CATCHUP_LIMIT=50

# Also parse attached .txt / .yaml / .conf documents for configs.
TELEGRAM_PARSE_DOCUMENTS=true

# === Rubika bot =============================================================
# Create the bot via https://rubika.ir/BotFather and paste the token here.
RUBIKA_BOT_TOKEN=123456:ABCDEF...

# Seconds between getUpdates polls.
RUBIKA_POLL_INTERVAL=2.0

# === Supabase (persistent state across GitHub Actions runs) =================
# Leave both empty to run in ephemeral "memory mode" (state resets every run).
# Project settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# === Delivery engine tuning =================================================
# Minimum score (0-100) a config needs before it is ever delivered.
MIN_SCORE=55
# Score at or above which a config may be delivered instantly in live mode.
INSTANT_SCORE=88
# How long the dispatcher waits to bundle configs into one digest (seconds).
BATCH_WINDOW=45
# Force-flush a batch once it holds this many configs.
BATCH_MAX=5
# Max configs a single user may receive per hour (0 = unlimited).
USER_HOURLY_CAP=60

# Rate limiting (protects you from Rubika throttling)
RATE_LIMIT_PER_CHAT=12      # messages per minute, per chat
RATE_LIMIT_GLOBAL=120       # messages per minute, across all chats

# Optional TCP reachability probe before delivering (off by default because
# GitHub Actions egress is restricted - enable if you self-host).
HEALTH_CHECK_ENABLED=false
HEALTH_CHECK_TIMEOUT=6

# === Runtime ================================================================
# Max seconds this process may live before handing over to a new workflow run.
# Must stay below the GitHub Actions 6h job limit. 20400s = 5h40m.
MAX_RUNTIME=20400
# Start the handoff this many seconds before MAX_RUNTIME elapses.
HANDOFF_LEAD=180

LOG_LEVEL=INFO
DEFAULT_LANGUAGE=en
